# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# Do not paste these values into chat; edit .env.local directly in your editor.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role
# Server-only. Bypasses RLS. Never expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=

# Project Settings -> Database -> Connection string -> URI (use the pooler/session
# connection string, "Connection pooling" tab, port 6543 or 5432 as provided).
# Required for schema discovery (RLS policy bodies, triggers, function source) —
# the REST API alone does not expose this. Server-only, never expose to the client.
SUPABASE_DB_URL=
